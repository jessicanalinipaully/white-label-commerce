NODE_ENV=development
DATABASE_URL=postgresql://commerce:commerce_password@localhost:5432/commerce?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Phase 6: Razorpay Payments & Webhook Config
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

# Phase 9: Google Maps Places & Geocoding API Key for Customer Address Autocomplete
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
