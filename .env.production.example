# Production Environment Configuration Template
# Copy this file to .env.production on your VPS and update values accordingly.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.

# Environment & Server Port
NODE_ENV=production
PORT=4000
API_PORT=4000

# PostgreSQL Production Connection (Docker service name: postgres)
DATABASE_URL=postgresql://commerce_user:CHANGE_THIS_SECURE_PASSWORD@postgres:5432/commerce_prod?schema=public

# Redis Production Connection (Docker service name: redis)
REDIS_URL=redis://redis:6379

# Security & JWT Authentication
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_PRODUCTION_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# Storefront & API URLs (Replace with your client's domain)
WEB_URL=https://yourclientdomain.com
NEXT_PUBLIC_API_URL=https://yourclientdomain.com/api
CORS_ORIGIN=https://yourclientdomain.com

# Razorpay Payment Gateway (Optional / Replace with live keys)
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Google Maps Places & Geocoding API Key (Restrict by HTTP Referrers in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY
